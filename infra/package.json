{
  "name": "@crediflow/infra",
  "version": "0.1.0",
  "private": true,
  "description": "Infraestructura como código de CrediFlow con AWS CDK (TypeScript)",
  "bin": {
    "crediflow": "bin/crediflow.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "synth": "cdk synth --quiet",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "ls": "cdk ls",
    "nag": "CF_NAG=true cdk synth --quiet"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "aws-cdk": "^2.1147.0",
    "esbuild": "^0.24.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.275.0",
    "cdk-nag": "^2.38.2",
    "constructs": "^10.4.2",
    "dotenv": "^16.4.7",
    "source-map-support": "^0.5.21"
  }
}
