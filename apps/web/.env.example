# ==========================================================
# CrediFlow Web - conexión con TU backend
# Copia a .env.local  (o genera este archivo con: npm run web:env)
# ==========================================================

# Sesión 2+: URL de la API de solicitudes (EC2 o ALB). Local: http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Sesión 5+: URL de la API serverless de precalificación (API Gateway, termina en /v1/)
NEXT_PUBLIC_PRECAL_URL=

# Sesión 5+: Cognito
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Etiqueta que se muestra en la cabecera
NEXT_PUBLIC_STUDENT=local
