# Puerto HTTP
PORT=3000
# memory | postgres | dynamo   (memory = sin base de datos, para correr local)
STORAGE=memory
# DynamoDB (sesión 3+; ECS lo inyecta)
TABLE_NAME=
# PostgreSQL (solo el despliegue manual de la sesión 2)
DB_HOST=
DB_PORT=5432
DB_NAME=crediflow
DB_USER=crediflow_admin
DB_PASSWORD=
# Cola de evaluación (sesión 5). Si está vacía, las solicitudes quedan en RECIBIDA.
QUEUE_URL=
# Bucket de documentos (sesión 3+)
DOCUMENTS_BUCKET=
AWS_REGION=us-east-1
