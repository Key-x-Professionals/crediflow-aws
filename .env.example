# ==========================================================
# CrediFlow - configuración por alumno
# Copia este archivo a .env (nunca se sube a git) y ajusta los valores.
#   Mac/Linux:  cp .env.example .env
#   Windows:    Copy-Item .env.example .env
# ==========================================================

# Identificador corto de alumno (solo minúsculas, números y guiones, máx 12).
# Se usa como prefijo de TODOS los recursos: crediflow-<alumno>-<env>-...
CF_STUDENT=edgar

# Entorno lógico: dev | prod
CF_ENV=dev

# Cuenta y región de AWS donde se despliega
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-east-1

# Perfil de AWS CLI creado con `aws login --profile crediflow` (credenciales temporales, sin llaves de acceso)
AWS_PROFILE=crediflow

# Correo para alertas (SNS / alarmas). Debe confirmarse la suscripción.
CF_ALERT_EMAIL=tu.correo@ejemplo.com

# Repositorio de GitHub de cada alumno para el pipeline con OIDC (sesión 3)
# Formato: usuario/repositorio
CF_GITHUB_REPO=mi-usuario/crediflow

# Opcional: IP pública desde la que se permite acceso al bastión/ALB en dev (x.x.x.x/32)
CF_ALLOWED_CIDR=0.0.0.0/0

# Costo: por defecto el VPC NO tiene NAT Gateway (~32 USD/mes). Solo para un ambiente tipo prod:
# CF_NAT=true
